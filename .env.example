FARO_ENV=development
FARO_LOG_LEVEL=INFO
FARO_CONFIG_PATH=config/app.example.yaml
FARO_DATA_DIR=data
FARO_DATABASE_URL=sqlite:///data/processed/faro.db

PDF_EXTRACTION_MODE=auto
PDF_MAX_PAGES=3
PDF_NATIVE_TEXT_MIN_CHARACTERS=40
PDF_NATIVE_TEXT_MIN_WORDS=5
OCR_ENABLED=true
OCR_COMMAND=tesseract
OCR_LANGUAGE=spa
OCR_RENDER_DPI=300
OCR_MIN_CONFIDENCE=0.75

IMAGE_MAX_FILE_SIZE_MB=25
IMAGE_MAX_WIDTH=12000
IMAGE_MAX_HEIGHT=12000
IMAGE_MAX_PIXELS=40000000
IMAGE_MIN_WIDTH=64
IMAGE_MIN_HEIGHT=64

UBL_MAX_FILE_SIZE_MB=25
UBL_MAX_ELEMENTS=50000
UBL_MAX_DEPTH=50
UBL_MAX_TEXT_CHARACTERS=5000000
