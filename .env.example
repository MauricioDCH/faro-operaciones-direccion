FARO_ENV=development
FARO_LOG_LEVEL=INFO
FARO_CONFIG_PATH=config/app.example.yaml
FARO_DATA_DIR=data
FARO_DATABASE_URL=sqlite:///data/processed/faro.db

PDF_EXTRACTION_MODE=auto
PDF_MAX_PAGES=3
PDF_NATIVE_TEXT_MIN_CHARACTERS=40
PDF_NATIVE_TEXT_MIN_WORDS=5
OCR_ENABLED=true
OCR_COMMAND=tesseract
OCR_LANGUAGE=spa
OCR_RENDER_DPI=300
OCR_MIN_CONFIDENCE=0.75
